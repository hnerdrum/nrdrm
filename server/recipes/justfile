export TEST_DATABASE_URL := env("TEST_DATABASE_URL", "postgres://nrdrm:nrdrm@localhost:5435/recipes_test")
stack_arch := env("STACK_ARCH", "aarch64")

[private]
default:
    @just --list

run: env build
    stack --arch={{ stack_arch }} exec server-exe

test: poppy-gen
    stack --arch={{ stack_arch }} test --fast recipes:recipes-test

test-fast:
    stack --arch={{ stack_arch }} test --fast recipes:recipes-test

build: poppy-gen
    stack --arch={{ stack_arch }} build

migrate:
    @echo "migrations apply automatically on run"

poppy-gen:
    stack --arch={{ stack_arch }} build recipes-codegen:exe:poppy-gen
    stack --arch={{ stack_arch }} exec poppy-gen

poppy-check:
    stack --arch={{ stack_arch }} build recipes-codegen:exe:poppy-gen
    stack --arch={{ stack_arch }} exec poppy-gen -- --check

schema-check: test-db-up
    stack --arch={{ stack_arch }} exec poppy-gen -- --check-schema

test-db-up:
    docker compose -f docker-compose.test.yml up -d --wait

test-db-down:
    docker compose -f docker-compose.test.yml down

test-db-logs:
    docker compose -f docker-compose.test.yml logs -f

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
