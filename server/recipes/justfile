export TEST_DATABASE_URL := env("TEST_DATABASE_URL", "postgres://nrdrm:nrdrm@localhost:5435/recipes_test")

[private]
default:
    @just --list

run: env build
    stack --arch=aarch64 exec server-exe

test: test-db-up
    stack --arch=aarch64 test

test-fast: orm-gen
    stack --arch=aarch64 test

build: orm-gen
    stack --arch=aarch64 build

migrate:
    @echo "migrations apply automatically on run"

orm-gen:
    stack --arch=aarch64 build recipes:orm-codegen
    stack --arch=aarch64 exec orm-codegen

orm-gen-check:
    stack --arch=aarch64 build recipes:orm-codegen
    stack --arch=aarch64 exec orm-codegen -- --check

orm-schema-check: test-db-up
    stack --arch=aarch64 exec orm-codegen -- --check-schema

test-db-up:
    docker compose -f docker-compose.test.yml up -d --wait

test-db-down:
    docker compose -f docker-compose.test.yml down

test-db-logs:
    docker compose -f docker-compose.test.yml logs -f

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
