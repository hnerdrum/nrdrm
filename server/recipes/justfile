[private]
default:
    @just --list

run: env
    make run

test:
    make test

build:
    make build

migrate:
    @echo "migrations apply automatically on run"

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
