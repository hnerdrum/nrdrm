{-# LANGUAGE FlexibleContexts #-}
{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE MultiParamTypeClasses #-}
{-# LANGUAGE NamedFieldPuns #-}
{-# LANGUAGE RecordWildCards #-}
{-# LANGUAGE TypeApplications #-}
{-# LANGUAGE TypeFamilies #-}

module Schema.Client.Shelf
  ( findMany,
    findUnique,
    findUniqueOrFail,
    withBooks,
    noInclude,
    WithBooks (..),
    NoInclude (..),
    ResolveInclude,
    ShelfQuery (..),
    OmitSelect (..),
    Picked (..),
    ShelfSelect (..),
    ShelfPicked (..),
    shelfSelect,
    ShelfWithBooksPicked (..)
  )
where

import Data.UUID (UUID)
import ORM.Db (Db)
import ORM.Errors (ORMError)
import qualified ORM.Include as Include
import qualified ORM.Operations as Ops
import ORM.Query (QueryBuilder, applyQueryModifiers, selectColumns)
import ORM.Select (OmitSelect (..), Picked (..))
import ORM.Where (Where)
import Schema.Shelf (ShelfTable, ShelfRow, ShelfSelect (..), ShelfPicked (..), shelfSelect, shelfSelectColumns, parseShelfPicked, toShelfPicked)
import Schema.ShelfInclude ( ShelfInclude (..), BookInclude (..), ShelfWithBooks (..), BookWithChapters (..), WithBooks (..), NoInclude (..), ResolveInclude, unwrapWithBooks)

withBooks :: WithBooks
withBooks =
  WithBooks ShelfInclude {books = Just (BookInclude {chapters = True})}

noInclude :: NoInclude
noInclude = NoInclude ShelfInclude {books = Nothing}

data ShelfWithBooksPicked = ShelfWithBooksPicked
  { shelf :: ShelfPicked,
    books :: [BookWithChapters]
  }
  deriving (Show, Eq)

toShelfWithBooksPicked :: ShelfSelect -> ShelfWithBooks -> ShelfWithBooksPicked
toShelfWithBooksPicked select_ ShelfWithBooks {shelf, books} =
  ShelfWithBooksPicked
    { shelf = toShelfPicked select_ shelf
    , books = books
    }

data ShelfQuery preset select = ShelfQuery
  { select_ :: select
  , where_ :: Maybe (Where ShelfTable)
  , orderBy_ :: Maybe (QueryBuilder ShelfTable -> QueryBuilder ShelfTable)
  , limit_ :: Maybe Int
  , offset_ :: Maybe Int
  }

type instance ResolveInclude (ShelfQuery WithBooks OmitSelect) = ShelfWithBooks
type instance ResolveInclude (ShelfQuery NoInclude OmitSelect) = ShelfRow
type instance ResolveInclude (ShelfQuery WithBooks ShelfSelect) = ShelfWithBooksPicked
type instance ResolveInclude (ShelfQuery NoInclude ShelfSelect) = ShelfPicked

class FindManyShelf preset where
  findMany :: preset -> Db [ResolveInclude preset]

instance FindManyShelf WithBooks where
  findMany preset =
    Include.findMany @ShelfTable (unwrapWithBooks preset) Prelude.id

instance FindManyShelf NoInclude where
  findMany _ =
    Ops.findMany @ShelfTable @ShelfRow Prelude.id

instance FindManyShelf (ShelfQuery WithBooks OmitSelect) where
  findMany ShelfQuery {where_, orderBy_, limit_, offset_} =
    Include.findMany @ShelfTable (unwrapWithBooks withBooks) (applyQueryModifiers where_ orderBy_ limit_ offset_)

instance FindManyShelf (ShelfQuery NoInclude OmitSelect) where
  findMany ShelfQuery {where_, orderBy_, limit_, offset_} =
    Ops.findMany @ShelfTable @ShelfRow (applyQueryModifiers where_ orderBy_ limit_ offset_)

instance FindManyShelf (ShelfQuery WithBooks ShelfSelect) where
  findMany ShelfQuery {select_, where_, orderBy_, limit_, offset_} = do
    rows <- Include.findMany @ShelfTable (unwrapWithBooks withBooks) (applyQueryModifiers where_ orderBy_ limit_ offset_)
    pure $ map (toShelfWithBooksPicked select_) rows

instance FindManyShelf (ShelfQuery NoInclude ShelfSelect) where
  findMany ShelfQuery {select_, where_, orderBy_, limit_, offset_} =
    Ops.findManyWith
      (parseShelfPicked select_)
      (selectColumns (shelfSelectColumns select_) . applyQueryModifiers where_ orderBy_ limit_ offset_)

class FindUniqueShelf preset where
  findUnique :: preset -> UUID -> Db (Maybe (ResolveInclude preset))


instance FindUniqueShelf WithBooks where
  findUnique preset =
    Include.findUnique @ShelfTable (unwrapWithBooks preset)

instance FindUniqueShelf NoInclude where
  findUnique _ =
    Ops.findUnique @ShelfTable @ShelfRow

class FindUniqueOrFailShelf preset where
  findUniqueOrFail :: preset -> UUID -> Db (Either ORMError (ResolveInclude preset))


instance FindUniqueOrFailShelf WithBooks where
  findUniqueOrFail preset =
    Include.findUniqueOrFail @ShelfTable (unwrapWithBooks preset)

instance FindUniqueOrFailShelf NoInclude where
  findUniqueOrFail _ =
    Ops.findUniqueOrFail @ShelfTable @ShelfRow
