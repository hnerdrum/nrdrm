{-# LANGUAGE FlexibleContexts #-}
{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE RecordWildCards #-}
{-# LANGUAGE TypeApplications #-}
{-# LANGUAGE TypeFamilies #-}

module ORM.Client.RecipeIngredient
  ( create,
    update,
    findMany,
    findUnique,
    findUniqueOrFail,
    delete,
    deleteMany,
    RecipeIngredientCreate (..),
    RecipeIngredientRow (..),
    RecipeIngredientSelect (..),
    RecipeIngredientPicked (..),
    recipeIngredientSelect,
    OmitSelect (..),
    Picked (..),
    ResolveSelect,
    RecipeIngredientUpdate (..),
    RecipeIngredientTable,
    RecipeIngredientQuery (..),
    emptyQuery,
    recipeIngredientId
  )

where

import Data.UUID (UUID)
import ORM.Db (Db)
import ORM.Errors (ORMError (..), requireFound)
import qualified ORM.Delete as Delete
import qualified ORM.Insert as Insert
import qualified ORM.Operations as Ops
import ORM.Query (QueryBuilder, applyQueryModifiers, matching, selectColumns)
import ORM.Select (OmitSelect (..), Picked (..))
import ORM.Where (Where)
import ORM.Schema.RecipeIngredient (RecipeIngredientCreate (..), RecipeIngredientRow (..), RecipeIngredientSelect (..), RecipeIngredientPicked (..), recipeIngredientSelect, recipeIngredientSelectColumns, parseRecipeIngredientPicked, RecipeIngredientTable, RecipeIngredientUpdate (..), recipeIngredientId)
import qualified ORM.Update as Update

create :: RecipeIngredientCreate -> Db (Either ORMError RecipeIngredientRow)
create = Insert.insert @RecipeIngredientTable @RecipeIngredientRow


update :: UUID -> RecipeIngredientUpdate -> Db (Either ORMError RecipeIngredientRow)
update = Update.update @RecipeIngredientTable @RecipeIngredientRow


data RecipeIngredientQuery select = RecipeIngredientQuery
  { select_ :: select
  , where_ :: Maybe (Where RecipeIngredientTable)
  , orderBy_ :: Maybe (QueryBuilder RecipeIngredientTable -> QueryBuilder RecipeIngredientTable)
  , limit_ :: Maybe Int
  , offset_ :: Maybe Int
  }


emptyQuery :: RecipeIngredientQuery OmitSelect
emptyQuery =
  RecipeIngredientQuery {select_ = OmitSelect, where_ = Nothing, orderBy_ = Nothing, limit_ = Nothing, offset_ = Nothing}


type family ResolveSelect select
type instance ResolveSelect OmitSelect = RecipeIngredientRow
type instance ResolveSelect RecipeIngredientSelect = RecipeIngredientPicked


class ReadRecipeIngredient select where
  findMany :: RecipeIngredientQuery select -> Db [ResolveSelect select]
  findUnique :: RecipeIngredientQuery select -> Db (Either ORMError (Maybe (ResolveSelect select)))
  findUniqueOrFail :: RecipeIngredientQuery select -> Db (Either ORMError (ResolveSelect select))

instance ReadRecipeIngredient OmitSelect where
  findMany q =
    Ops.findMany @RecipeIngredientTable @RecipeIngredientRow (applyQuery q)
  findUnique RecipeIngredientQuery {where_} =
    Ops.findUniqueWhere @RecipeIngredientTable @RecipeIngredientRow where_
  findUniqueOrFail q = do
    result <- findUnique q
    case result of
      Left err -> pure (Left err)
      Right found -> pure $ requireFound found (RecordNotFound "No record found matching query")

instance ReadRecipeIngredient RecipeIngredientSelect where
  findMany q@RecipeIngredientQuery {select_} =
    Ops.findManyWith
      (parseRecipeIngredientPicked select_)
      (selectColumns (recipeIngredientSelectColumns select_) . applyQuery q)
  findUnique RecipeIngredientQuery {select_, where_} =
    case Ops.requireUniqueWhere @RecipeIngredientTable where_ of
      Left err -> pure (Left err)
      Right w -> do
        rows <-
          Ops.findManyWith
            (parseRecipeIngredientPicked select_)
            (selectColumns (recipeIngredientSelectColumns select_) . matching w)
        pure $ case rows of
          [] -> Right Nothing
          [row] -> Right (Just row)
          _ -> Left (MultipleRecordsFound "findUnique matched multiple rows")
  findUniqueOrFail q = do
    result <- findUnique q
    case result of
      Left err -> pure (Left err)
      Right found -> pure $ requireFound found (RecordNotFound "No record found matching query")

applyQuery :: RecipeIngredientQuery select -> QueryBuilder RecipeIngredientTable -> QueryBuilder RecipeIngredientTable
applyQuery RecipeIngredientQuery {where_, orderBy_, limit_, offset_} =
  applyQueryModifiers where_ orderBy_ limit_ offset_


delete :: UUID -> Db Int
delete = Ops.delete @RecipeIngredientTable


deleteMany :: Where RecipeIngredientTable -> Db (Either ORMError Int)
deleteMany = Delete.deleteMany @RecipeIngredientTable

