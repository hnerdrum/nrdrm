{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE FlexibleContexts #-}
{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE MultiParamTypeClasses #-}
{-# LANGUAGE OverloadedRecordDot #-}
{-# LANGUAGE RecordWildCards #-}
{-# LANGUAGE TypeApplications #-}
{-# LANGUAGE TypeFamilies #-}

module ORM.Client.Recipe
  ( findMany,
    findUnique,
    findUniqueOrFail,
    create,
    update,
    delete,
    deleteMany,
    RecipeWriteCreate (..),
    RecipeWriteUpdate (..),
    RecipeIngredientNestedCreate (..),
    withIngredients,
    noInclude,
    WithIngredients (..),
    NoInclude (..),
    ResolveInclude,
    RecipeQuery (..),
    RecipeCreate (..),
    RecipeRow (..),
    RecipeUpdate (..),
    RecipeWithIngredients (..),
    RecipeIngredientWithIngredient (..),
    RecipeIngredientRow (..),
    IngredientRow (..),
    Unit (..),
  )
where

import Control.Monad (forM_)
import Data.UUID (UUID)
import qualified Data.UUID.V4 as V4
import ORM.PG (toField)
import ORM.Core (fieldColumn)
import ORM.Db (Db, liftIO, transaction)
import qualified ORM.Delete as Delete
import ORM.Errors (ORMError)
import qualified ORM.Include as Include
import qualified ORM.Insert as Insert
import ORM.Schema.Recipe ( RecipeCreate (..), RecipeRow (..), RecipeTable, RecipeUpdate (..))
import ORM.Schema.RecipeInclude ( RecipeInclude (..), RecipeIngredientInclude (..), RecipeWithIngredients (..), RecipeIngredientWithIngredient (..), WithIngredients (..), NoInclude (..), ResolveInclude, unwrapWithIngredients)
import ORM.Schema.RecipeIngredient ( RecipeIngredientCreate (..), RecipeIngredientRow (..), RecipeIngredientTable, recipeIngredientRecipeId)
import qualified ORM.Operations as Ops
import ORM.Query (QueryBuilder, applyQueryModifiers)
import ORM.Where (Where)
import qualified ORM.Update as Update
import ORM.Schema.Ingredient (IngredientRow (..))
import ORM.Schema.Unit (Unit (..))

data RecipeWriteCreate = RecipeWriteCreate
  { root :: RecipeCreate
  , ingredients :: [RecipeIngredientNestedCreate]
  }
  deriving (Show, Eq)

data RecipeIngredientNestedCreate = RecipeIngredientNestedCreate
  { ingredientId :: UUID, amount :: Int, unit :: Unit
  }
  deriving (Show, Eq)

data RecipeWriteUpdate = RecipeWriteUpdate
  { root :: RecipeUpdate
  , ingredients :: Maybe [RecipeIngredientNestedCreate]
  }
  deriving (Show, Eq)

toRecipeIngredientCreate :: UUID -> RecipeIngredientNestedCreate -> RecipeIngredientCreate
toRecipeIngredientCreate parentId nested =
  RecipeIngredientCreate
    { id = Nothing,
      ingredientId = nested.ingredientId,
      amount = nested.amount,
      unit = nested.unit,
      recipeId = parentId
    }

withIngredients :: WithIngredients
withIngredients =
  WithIngredients RecipeInclude {ingredients = Just (RecipeIngredientInclude {ingredient = True})}

noInclude :: NoInclude
noInclude = NoInclude RecipeInclude {ingredients = Nothing}

data RecipeQuery preset = RecipeQuery
  { where_ :: Maybe (Where RecipeTable)
  , orderBy_ :: Maybe (QueryBuilder RecipeTable -> QueryBuilder RecipeTable)
  , limit_ :: Maybe Int
  , offset_ :: Maybe Int
  }

type instance ResolveInclude (RecipeQuery WithIngredients) = RecipeWithIngredients
type instance ResolveInclude (RecipeQuery NoInclude) = RecipeRow

class FindManyRecipe preset where
  findMany :: preset -> Db [ResolveInclude preset]

instance FindManyRecipe WithIngredients where
  findMany preset =
    Include.findMany @RecipeTable (unwrapWithIngredients preset) Prelude.id

instance FindManyRecipe NoInclude where
  findMany _ =
    Ops.findMany @RecipeTable @RecipeRow Prelude.id

instance FindManyRecipe (RecipeQuery WithIngredients) where
  findMany RecipeQuery {..} =
    Include.findMany @RecipeTable (unwrapWithIngredients withIngredients) (applyQueryModifiers where_ orderBy_ limit_ offset_)

instance FindManyRecipe (RecipeQuery NoInclude) where
  findMany RecipeQuery {..} =
    Ops.findMany @RecipeTable @RecipeRow (applyQueryModifiers where_ orderBy_ limit_ offset_)

class FindUniqueRecipe preset where
  findUnique :: preset -> UUID -> Db (Maybe (ResolveInclude preset))


instance FindUniqueRecipe WithIngredients where
  findUnique preset =
    Include.findUnique @RecipeTable (unwrapWithIngredients preset)

instance FindUniqueRecipe NoInclude where
  findUnique _ =
    Ops.findUnique @RecipeTable @RecipeRow

class FindUniqueOrFailRecipe preset where
  findUniqueOrFail :: preset -> UUID -> Db (Either ORMError (ResolveInclude preset))


instance FindUniqueOrFailRecipe WithIngredients where
  findUniqueOrFail preset =
    Include.findUniqueOrFail @RecipeTable (unwrapWithIngredients preset)

instance FindUniqueOrFailRecipe NoInclude where
  findUniqueOrFail _ =
    Ops.findUniqueOrFail @RecipeTable @RecipeRow

create ::
  WithIngredients ->
  RecipeWriteCreate ->
  Db (Either ORMError RecipeWithIngredients)
create include input = transaction $ do
  rootId <- liftIO $ maybe V4.nextRandom pure input.root.id
  let rootInput =
        RecipeCreate { id = Just rootId, createdAt = input.root.createdAt, updatedAt = input.root.updatedAt, name = input.root.name, description = input.root.description }
  rootResult <-
    Insert.insert @RecipeTable @RecipeRow rootInput
  case rootResult of
    Left err -> pure (Left err)
    Right _ -> do
      forM_ input.ingredients $ \nested ->
        Insert.executeInsert $
          Insert.toInsertBuilder @RecipeIngredientTable (toRecipeIngredientCreate rootId nested)
      Include.findUniqueOrFail @RecipeTable (unwrapWithIngredients include) rootId

update ::
  WithIngredients ->
  UUID ->
  RecipeWriteUpdate ->
  Db (Either ORMError RecipeWithIngredients)
update include rootId input = transaction $ do
  updateResult <-
    Update.update @RecipeTable @RecipeRow rootId input.root
  case updateResult of
    Left err -> pure (Left err)
    Right _ -> do
      case input.ingredients of
        Nothing -> pure ()
        Just nestedItems -> do
          _ <-
            Delete.deleteWhere $
              Delete.whereDelete (fieldColumn recipeIngredientRecipeId <> " = ?") [toField rootId] (Delete.emptyDelete @RecipeIngredientTable)
          forM_ nestedItems $ \nested ->
            Insert.executeInsert $
              Insert.toInsertBuilder @RecipeIngredientTable (toRecipeIngredientCreate rootId nested)
      Include.findUniqueOrFail @RecipeTable (unwrapWithIngredients include) rootId

delete :: UUID -> Db Int
delete = Ops.delete @RecipeTable

deleteMany :: Where RecipeTable -> Db (Either ORMError Int)
deleteMany = Delete.deleteMany @RecipeTable