{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE RecordWildCards #-}
{-# LANGUAGE TypeApplications #-}
{-# LANGUAGE TypeFamilies #-}

module ORM.Client.Ingredient
  ( create,
    update,
    findMany,
    findUnique,
    findUniqueOrFail,
    delete,
    deleteMany,
    IngredientCreate (..),
    IngredientRow (..),
    IngredientSelect (..),
    IngredientPicked (..),
    ingredientSelect,
    OmitSelect (..),
    Picked (..),
    ResolveSelect,
    IngredientUpdate (..),
    IngredientTable,
    IngredientQuery (..),
    emptyQuery
  )

where

import Data.UUID (UUID)
import ORM.Db (Db)
import ORM.Errors (ORMError)
import qualified ORM.Delete as Delete
import qualified ORM.Insert as Insert
import qualified ORM.Operations as Ops
import ORM.Query (QueryBuilder, applyQueryModifiers, selectColumns)
import ORM.Select (OmitSelect (..), Picked (..))
import ORM.Where (Where)
import ORM.Schema.Ingredient (IngredientCreate (..), IngredientRow (..), IngredientSelect (..), IngredientPicked (..), ingredientSelect, ingredientSelectColumns, parseIngredientPicked, IngredientTable, IngredientUpdate (..))
import qualified ORM.Update as Update

create :: IngredientCreate -> Db (Either ORMError IngredientRow)
create = Insert.insert @IngredientTable @IngredientRow


update :: UUID -> IngredientUpdate -> Db (Either ORMError IngredientRow)
update = Update.update @IngredientTable @IngredientRow


data IngredientQuery select = IngredientQuery
  { select_ :: select
  , where_ :: Maybe (Where IngredientTable)
  , orderBy_ :: Maybe (QueryBuilder IngredientTable -> QueryBuilder IngredientTable)
  , limit_ :: Maybe Int
  , offset_ :: Maybe Int
  }


emptyQuery :: IngredientQuery OmitSelect
emptyQuery =
  IngredientQuery {select_ = OmitSelect, where_ = Nothing, orderBy_ = Nothing, limit_ = Nothing, offset_ = Nothing}


type family ResolveSelect select
type instance ResolveSelect OmitSelect = IngredientRow
type instance ResolveSelect IngredientSelect = IngredientPicked


class FindManyIngredient select where
  findMany :: IngredientQuery select -> Db [ResolveSelect select]

instance FindManyIngredient OmitSelect where
  findMany q =
    Ops.findMany @IngredientTable @IngredientRow (applyQuery q)

instance FindManyIngredient IngredientSelect where
  findMany q@IngredientQuery {select_} =
    Ops.findManyWith
      (parseIngredientPicked select_)
      (selectColumns (ingredientSelectColumns select_) . applyQuery q)

applyQuery :: IngredientQuery select -> QueryBuilder IngredientTable -> QueryBuilder IngredientTable
applyQuery IngredientQuery {where_, orderBy_, limit_, offset_} =
  applyQueryModifiers where_ orderBy_ limit_ offset_


findUnique :: UUID -> Db (Maybe IngredientRow)
findUnique = Ops.findUnique @IngredientTable @IngredientRow


findUniqueOrFail :: UUID -> Db (Either ORMError IngredientRow)
findUniqueOrFail = Ops.findUniqueOrFail @IngredientTable @IngredientRow


delete :: UUID -> Db Int
delete = Ops.delete @IngredientTable


deleteMany :: Where IngredientTable -> Db (Either ORMError Int)
deleteMany = Delete.deleteMany @IngredientTable

