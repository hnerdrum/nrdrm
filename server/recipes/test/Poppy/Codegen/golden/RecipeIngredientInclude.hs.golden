{-# LANGUAGE AllowAmbiguousTypes #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE FlexibleContexts #-}
{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE MultiParamTypeClasses #-}
{-# LANGUAGE NoFieldSelectors #-}
{-# LANGUAGE OverloadedRecordDot #-}
{-# LANGUAGE TypeApplications #-}
{-# LANGUAGE TypeFamilies #-}
{-# LANGUAGE TypeOperators #-}
{-# LANGUAGE UndecidableInstances #-}

module ORM.Schema.RecipeIngredientInclude
  ( RecipeIngredientInclude (..),
    NoInclude (..),
    ResolveInclude,
    unwrapNoInclude,
    WithIngredient (..),
    unwrapWithIngredient,
    RecipeIngredientWithIngredient (..),
    IncludeIngredient (..)
  )
where

import Data.Kind (Type)
import Poppy.Db (Db)
import Poppy.Include
  ( ExecuteInclude (..),
    IncludesJoin (..),
    NestInclude (..)
  )
import Poppy.Operations (findMany)
import Poppy.SelectIn
  ( findByIn,
    prepareIncludeRootQuery,
    emptyByPk,
    indexByPk,
    lookupByPk
  )
import ORM.Schema.RecipeIngredient (RecipeIngredientTable, RecipeIngredientRow (..))
import ORM.Schema.Ingredient (IngredientTable, IngredientRow (..))
import qualified ORM.Schema.Ingredient as Ingredient

newtype RecipeIngredientInclude = RecipeIngredientInclude
  { ingredient :: Bool
  }
  deriving (Show, Eq)

data RecipeIngredientWithIngredient = RecipeIngredientWithIngredient
  { recipeIngredient :: RecipeIngredientRow,
    ingredient :: Maybe IngredientRow
  }
  deriving (Show, Eq)

newtype WithIngredient = WithIngredient RecipeIngredientInclude
  deriving (Show, Eq)

unwrapWithIngredient :: WithIngredient -> RecipeIngredientInclude
unwrapWithIngredient (WithIngredient include) = include

type family ResolveInclude preset :: Type
type instance ResolveInclude NoInclude = RecipeIngredientRow
type instance ResolveInclude WithIngredient = RecipeIngredientWithIngredient

newtype NoInclude = NoInclude RecipeIngredientInclude
  deriving (Show, Eq)

unwrapNoInclude :: NoInclude -> RecipeIngredientInclude
unwrapNoInclude (NoInclude include) = include

instance IncludesJoin RecipeIngredientInclude where
  includesJoin include = include.ingredient

instance NestInclude RecipeIngredientInclude RecipeIngredientWithIngredient where
  type RootRow RecipeIngredientInclude = RecipeIngredientRow
  wrapRoot _ recipeIngredient = RecipeIngredientWithIngredient {recipeIngredient, ingredient = Nothing}

loadRecipeIngredientInclude :: RecipeIngredientInclude -> [RecipeIngredientRow] -> Db [RecipeIngredientWithIngredient]
loadRecipeIngredientInclude include roots = do
  ingredientMap <-
    if include.ingredient
      then indexByPk (.id) <$> findByIn @IngredientTable @IngredientRow Ingredient.ingredientId (map (.ingredientId) roots)
      else pure emptyByPk
  pure
    [
      RecipeIngredientWithIngredient {
        recipeIngredient = root,
        ingredient = lookupByPk root.ingredientId ingredientMap
      }
    | root <- roots
    ]


instance {-# OVERLAPPING #-} ExecuteInclude RecipeIngredientTable RecipeIngredientInclude RecipeIngredientWithIngredient where
  executeInclude include modifier = do
    roots <- findMany @RecipeIngredientTable @RecipeIngredientRow (prepareIncludeRootQuery @RecipeIngredientTable modifier)
    loadRecipeIngredientInclude include roots

instance {-# OVERLAPPING #-} ExecuteInclude RecipeIngredientTable WithIngredient RecipeIngredientWithIngredient where
  executeInclude (WithIngredient include) modifier = executeInclude include modifier

class IncludeIngredient include where
  ingredient :: include

instance IncludeIngredient WithIngredient where
  ingredient =
    WithIngredient RecipeIngredientInclude {ingredient = True}


