{-# LANGUAGE AllowAmbiguousTypes #-}
{-# LANGUAGE DuplicateRecordFields #-}
{-# LANGUAGE NoFieldSelectors #-}
{-# LANGUAGE OverloadedRecordDot #-}
{-# LANGUAGE TypeApplications #-}

module ORM.Schema.RecipeIngredient
  ( RecipeIngredientTable (..),
    RecipeIngredientRow (..),
    RecipeIngredientSelect (..),
    RecipeIngredientPicked (..),
    recipeIngredientSelect,
    recipeIngredientSelectColumns,
    parseRecipeIngredientPicked,
    toRecipeIngredientPicked,
    RecipeIngredientCreate (..),
    RecipeIngredientUpdate (..),
    recipeIngredientId,
    recipeIngredientRecipeId,
    recipeIngredientIngredientId,
    recipeIngredientAmount,
    recipeIngredientUnit,
    ingredient
  )
where

import Data.Text (Text)
import Data.UUID (UUID)
import Poppy.PG (FromRow (..), RowParser, field)
import Poppy.Core
import Poppy.Select (Picked (..), picked)
import Poppy.Insert (Insertable (..), emptyInsert, set, setMaybe)
import Poppy.Update (Updatable (..), emptyUpdate, setFieldMaybe)
import Poppy.Relation (BelongsTo (..), JoinType (..))
import ORM.Schema.Unit (Unit)
import ORM.Schema.Ingredient (IngredientTable)
import qualified ORM.Schema.Ingredient as Ingredient

data RecipeIngredientTable = RecipeIngredientTable

type instance PrimaryKeyType RecipeIngredientTable = UUID

instance Entity RecipeIngredientTable where
  tableName = "recipe_ingredient"
  primaryKey = recipeIngredientId
  tableColumns = ["id", "recipe_id", "ingredient_id", "amount", "unit"]
  uniqueKeys = [["id"], ["recipe_id", "ingredient_id"]]

instance Insertable RecipeIngredientTable where
  type CreateInput RecipeIngredientTable = RecipeIngredientCreate
  toInsertBuilder input =
    setMaybe recipeIngredientId input.id $
      set recipeIngredientRecipeId input.recipeId $
      set recipeIngredientIngredientId input.ingredientId $
      set recipeIngredientAmount input.amount $
      set recipeIngredientUnit input.unit $
      emptyInsert @RecipeIngredientTable


instance Updatable RecipeIngredientTable where
  type UpdateInput RecipeIngredientTable = RecipeIngredientUpdate
  updatedAtField = Nothing
  toUpdateBuilder input =
    setFieldMaybe recipeIngredientRecipeId input.recipeId $
      setFieldMaybe recipeIngredientIngredientId input.ingredientId $
      setFieldMaybe recipeIngredientAmount input.amount $
      setFieldMaybe recipeIngredientUnit input.unit $
      emptyUpdate @RecipeIngredientTable


data RecipeIngredientRow = RecipeIngredientRow
  { id :: UUID,
    recipeId :: UUID,
    ingredientId :: UUID,
    amount :: Int,
    unit :: Unit
  }
  deriving (Show, Eq)


data RecipeIngredientCreate = RecipeIngredientCreate
  { id :: Maybe UUID,
    recipeId :: UUID,
    ingredientId :: UUID,
    amount :: Int,
    unit :: Unit
  }
  deriving (Show, Eq)


data RecipeIngredientUpdate = RecipeIngredientUpdate
  { recipeId :: Maybe UUID,
    ingredientId :: Maybe UUID,
    amount :: Maybe Int,
    unit :: Maybe Unit
  }
  deriving (Show, Eq)


instance FromRow RecipeIngredientRow where
  fromRow = RecipeIngredientRow <$> field <*> field <*> field <*> field <*> field


data RecipeIngredientSelect = RecipeIngredientSelect
  { id :: Bool,
    recipeId :: Bool,
    ingredientId :: Bool,
    amount :: Bool,
    unit :: Bool
  }
  deriving (Show, Eq)
data RecipeIngredientPicked = RecipeIngredientPicked
  { id :: UUID,
    recipeId :: Picked UUID,
    ingredientId :: Picked UUID,
    amount :: Picked Int,
    unit :: Picked Unit
  }
  deriving (Show, Eq)
recipeIngredientSelect :: RecipeIngredientSelect
recipeIngredientSelect =
  RecipeIngredientSelect
    { id = False,
      recipeId = False,
      ingredientId = False,
      amount = False,
      unit = False
    }
recipeIngredientSelectColumns :: RecipeIngredientSelect -> [Text]
recipeIngredientSelectColumns select_ =
  fieldColumn recipeIngredientId
    : concat
      [ [fieldColumn recipeIngredientRecipeId | select_.recipeId]
      , [fieldColumn recipeIngredientIngredientId | select_.ingredientId]
      , [fieldColumn recipeIngredientAmount | select_.amount]
      , [fieldColumn recipeIngredientUnit | select_.unit]
      ]
parseRecipeIngredientPicked :: RecipeIngredientSelect -> RowParser RecipeIngredientPicked
parseRecipeIngredientPicked select_ = do
  idVal <- field
  recipeIdVal <- if select_.recipeId then Picked <$> field else pure Skipped
  ingredientIdVal <- if select_.ingredientId then Picked <$> field else pure Skipped
  amountVal <- if select_.amount then Picked <$> field else pure Skipped
  unitVal <- if select_.unit then Picked <$> field else pure Skipped
  pure RecipeIngredientPicked { id = idVal, recipeId = recipeIdVal, ingredientId = ingredientIdVal, amount = amountVal, unit = unitVal }
toRecipeIngredientPicked :: RecipeIngredientSelect -> RecipeIngredientRow -> RecipeIngredientPicked
toRecipeIngredientPicked select_ row =
  RecipeIngredientPicked
    { id = row.id,
      recipeId = picked select_.recipeId row.recipeId,
      ingredientId = picked select_.ingredientId row.ingredientId,
      amount = picked select_.amount row.amount,
      unit = picked select_.unit row.unit
    }


recipeIngredientId :: Field RecipeIngredientTable UUID
recipeIngredientId = Field "id" "id"

recipeIngredientRecipeId :: Field RecipeIngredientTable UUID
recipeIngredientRecipeId = Field "recipeId" "recipe_id"

recipeIngredientIngredientId :: Field RecipeIngredientTable UUID
recipeIngredientIngredientId = Field "ingredientId" "ingredient_id"

recipeIngredientAmount :: Field RecipeIngredientTable Int
recipeIngredientAmount = Field "amount" "amount"

recipeIngredientUnit :: Field RecipeIngredientTable Unit
recipeIngredientUnit = Field "unit" "unit"

ingredient :: BelongsTo RecipeIngredientTable IngredientTable UUID
ingredient =
  BelongsTo
    { foreignKey = recipeIngredientIngredientId,
      references = Ingredient.ingredientId,
      joinType = LeftJoin
    }

