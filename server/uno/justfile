[private]
default:
    @just --list

run: env
    go run .

test:
    @echo "no tests yet"

build:
    go build .

migrate:
    @echo "GORM AutoMigrate on run"

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
