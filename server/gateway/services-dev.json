[
  {
    "name": "recipes",
    "base_url": "http://localhost:8000/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": [
        {
          "path": "*",
          "methods": ["put", "delete"]
        },
        {
          "path": "ingredients/*",
          "methods": ["put", "delete"]
        }
      ]
    }
  },
  {
    "name": "identity",
    "base_url": "http://localhost:8081/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": []
    }
  }
]
