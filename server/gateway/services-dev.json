[
  {
    "name": "recipes",
    "base_url": "http://localhost:8000/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": [
        {
          "path": "*",
          "methods": ["put", "delete"]
        },
        {
          "path": "ingredients/*",
          "methods": ["put", "delete"]
        }
      ]
    }
  },
  {
    "name": "identity",
    "base_url": "http://localhost:8081/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": []
    }
  },
  {
    "name": "agents",
    "base_url": "http://localhost:8090",
    "request": {
      "forward_headers": [
        "content-type",
        "x-nrdrm-client",
        "x-hub-signature-256",
        "x-github-delivery",
        "x-github-event"
      ]
    },
    "response": {
      "forward_headers": []
    },
    "security": {
      "auth": [
        {
          "path": "complete",
          "methods": ["post"],
          "scheme": "bearer",
          "audience": "agents"
        },
        {
          "path": "runs",
          "methods": ["post"],
          "scheme": "bearer",
          "audience": "agents"
        },
        {
          "path": "runs/*",
          "methods": ["get"],
          "scheme": "bearer",
          "audience": "agents"
        }
      ]
    }
  }
]
