[
  {
    "name": "recipes",
    "base_url": "http://localhost:8000/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": [
        {
          "path": "/recipes/*",
          "methods": ["PUT", "DELETE"]
        },
        {
          "path": "/recipes/*/ingredients",
          "methods": ["PUT", "DELETE"]
        }
      ]
    }
  }
]
