[private]
default:
    @just --list

run: env
    gleam run

test:
    gleam test

build:
    gleam build

migrate:
    @echo "no database"

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
