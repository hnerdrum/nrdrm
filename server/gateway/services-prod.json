[
  {
    "name": "recipes",
    "base_url": "https://recipes.api.nrdrm.dev/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": [
        {
          "path": "*",
          "methods": ["put", "delete"]
        },
        {
          "path": "ingredients/*",
          "methods": ["put", "delete"]
        }
      ]
    }
  },
  {
    "name": "identity",
    "base_url": "https://identity.api.nrdrm.dev/api/v1",
    "request": {
      "forward_headers": ["content-type", "cookie"]
    },
    "response": {
      "forward_headers": ["set-cookie"]
    },
    "security": {
      "auth": []
    }
  },
  {
    "name": "agents",
    "base_url": "https://agents.api.nrdrm.dev",
    "request": {
      "forward_headers": ["content-type", "x-nrdrm-client"],
      "authorization": true
    },
    "response": {
      "forward_headers": []
    },
    "security": {
      "auth": [
        {
          "path": "complete",
          "methods": ["post"],
          "scheme": "bearer",
          "audience": "agents"
        },
        {
          "path": "runs",
          "methods": ["post"],
          "scheme": "bearer",
          "audience": "agents"
        },
        {
          "path": "runs/*",
          "methods": ["get"],
          "scheme": "bearer",
          "audience": "agents"
        }
      ]
    }
  }
]
