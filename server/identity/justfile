[private]
default:
    @just --list

run: env migrate
    cargo run

test:
    cargo test

build:
    cargo build

migrate:
    diesel migration run

create-client name audience:
    cargo run --bin create-client -- {{ name }} {{ audience }}

create-user email password: env
    cargo run --bin create-user -- {{ email }} {{ password }}

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
