[private]
default:
    @just --list

run: env migrate
    cargo run

test:
    @echo "no tests yet"

build:
    cargo build

migrate:
    diesel migration run

create-client name audience:
    cargo run --bin create-client -- {{ name }} {{ audience }}

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
