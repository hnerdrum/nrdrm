[private]
default:
    @just --list

run: env migrate
    npm run dev

test:
    npm test

build:
    npm run build

migrate:
    npm run migrate

env dest=".env":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
