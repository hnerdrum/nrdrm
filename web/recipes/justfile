[private]
default:
    @just --list

alias dev := run

run: env
    npm run dev

test:
    npm run lint

build:
    npm run build

migrate:
    @echo "no database"

env dest=".env.local":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -e "{{ dest }}" ]]; then
      exit 0
    fi
    cp .env.example "{{ dest }}"
    echo "created {{ dest }}"
