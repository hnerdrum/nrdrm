---
import header from '../assets/header.png';
---

<section id="home">
	<h1>9. mai 2026</h1>
	<img class="hero" src={header.src} alt="Ragnhild og Henrik" />
	<h3>Her var det tomt! Det kommer mer informasjon over nyttår - stay tuned!</h3>
</section>

<style>
	#home {
		min-height: 100vh;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 0 1.5rem 4rem;
		box-sizing: border-box;
	}
	h1 {
		font-size: clamp(3.5rem, 8vw, 14rem);
		font-family: 'Brittany', sans-serif;
		margin: 0;
	}

	.hero {
		width: clamp(300px, 50vw, 500px);
		border-radius: 1rem;
		object-fit: cover;
		margin: 0 auto;
		margin-bottom: 1rem;
	}
</style>
