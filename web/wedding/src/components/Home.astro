---
import header from '../assets/header.png';
---


<section id="home">
	<h1>9. mai 2026</h1>
	<img class="hero" src={header.src} alt="Ragnhild og Henrik" />
</section>

<style>
	#home {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 10rem);
		font-family: 'Brittany', sans-serif;
		margin: 0
	}

	.hero {
		width: clamp(300px, 50vw, 600px);
		border-radius: 1rem;
		object-fit: cover;
		margin: 0 auto;
	}
</style>
