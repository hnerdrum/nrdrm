---
import header from '../assets/header.png';
---


<section id="home">
	<h1>Ragnhild & Henrik</h1>
    <img class="hero" src={header.src} alt="Ragnhild og Henrik" />
</section>

<style>
	#home {
		width: 100%;
		max-width: 80%;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1rem;
		color: #1f1f1f;
	}
	h1 {
		font-size: clamp(2.5rem, 6vw, 10rem);
		font-family: 'Brittany', sans-serif;
        margin-top: 20%;
	}

    .hero {
		width: 100%;
		border-radius: 1rem;
		object-fit: cover;
        margin-left: 10%;
	}
</style>
