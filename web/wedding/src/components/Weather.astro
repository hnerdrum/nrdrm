<section id="weather">
	<h2>Vær</h2>

	<div class="weather-container">
		<iframe
			src="https://www.yr.no/nb/innhold/2-11844416/table.html"
			title="Værvarsel for Oslo"
			class="weather-iframe"></iframe>
	</div>
</section>

<style>
	#weather {
		min-height: 100vh;
		width: 100%;
		max-width: 800px;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 4rem 1.5rem;
		box-sizing: border-box;
	}

	h2 {
		font-family: 'Brittany', cursive;
		font-size: clamp(2.5rem, 5vw, 4rem);
		margin: 0 0 4rem;
	}

	.weather-container {
		width: 100%;
		max-width: 750px;
		background-color: #fdfbf0;
		border-radius: 0.5rem;
		padding: 0;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
		border: 2px solid #d5d0a8;
		box-sizing: border-box;
		overflow: hidden;
	}

	.weather-iframe {
		width: 100%;
		height: 520px;
		border: none;
		display: block;
	}

	@media (max-width: 640px) {
		.weather-iframe {
			height: 550px;
		}
	}
</style>
