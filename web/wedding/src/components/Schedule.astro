---
import { Icon } from 'astro-icon/components';
---

<section id="schedule">
	<h2>Program</h2>

	<div class="timeline-card">
		<ul class="timeline">
			<li>
				<div class="time">13:00</div>
				<div class="dot">
					<Icon name="lucide:heart" />
				</div>
				<div class="content">
					<h3>Vielse i bakgården</h3>
					<p>Ankomst via Dælenenggata 21-23.</p>
				</div>
			</li>
			<li>
				<div class="time">15:00</div>
				<div class="dot">
					<Icon name="lucide:wine" />
				</div>
				<div class="content">
					<h3>Mottakelse på Nordstrand Vel</h3>
					<p>Det blir mingling og lett servering.</p>
				</div>
			</li>
			<li>
				<div class="time">15:30</div>
				<div class="dot">
					<Icon name="lucide:users" />
				</div>
				<div class="content">
					<h3>Brudeparet ankommer</h3>
					<p>Og vi popper champagnen!</p>
				</div>
			</li>
			<li>
				<div class="time">16:30</div>
				<div class="dot">
					<Icon name="lucide:utensils-crossed" />
				</div>
				<div class="content">
					<h3>Middag</h3>
					<p>
						I regi av toastmestere Ida Nygård (959 30 588) og Melissa Blindheim (415 88 608).
						Kontakt dem innen 1. mai hvis du ønsker å holde tale.
					</p>
				</div>
			</li>
			<li>
				<div class="time">22:00</div>
				<div class="dot">
					<Icon name="lucide:music" />
				</div>
				<div class="content">
					<h3>Fest</h3>
					<p>Vi smeller i gang og holder det gående utover kvelden.</p>
				</div>
			</li>
		</ul>
	</div>
</section>

<style>
	#schedule {
		min-height: 100vh;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 4rem 1.5rem;
		box-sizing: border-box;
	}

	h2 {
		font-family: 'Brittany', cursive;
		font-size: clamp(2.5rem, 5vw, 4rem);
		margin: 0 0 4rem;
	}

	.timeline-card {
		position: relative;
		width: 100%;
		max-width: 750px;
		background-color: #fdfbf0;
		border-radius: 0.5rem;
		padding: 2.5rem 2rem;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
		border: 2px solid #d5d0a8;
		box-sizing: border-box;
	}

	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.timeline li {
		display: grid;
		grid-template-columns: 80px auto 1fr;
		align-items: center;
		column-gap: 1.5rem;
		position: relative;
	}

	.time {
		text-align: right;
		color: rgba(0, 0, 0, 0.5);
		font-size: 1rem;
	}

	.dot {
		width: 46px;
		height: 46px;
		border-radius: 999px;
		background-color: #fcadc1;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fdfbf0;
		z-index: 1;
	}

	.dot :global(svg) {
		width: 24px;
		height: 24px;
		stroke: currentColor;
		fill: none;
		stroke-width: 2;
	}

	.content h3 {
		margin: 0 0 0.25rem;
		font-size: 1.2rem;
	}

	.content p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.5;
		color: rgba(0, 0, 0, 0.8);
	}

	@media (max-width: 640px) {
		.timeline-card {
			padding: 2rem 1.5rem;
		}

		.timeline li {
			grid-template-columns: auto minmax(0, 1fr);
			grid-template-rows: auto auto;
			column-gap: 1rem;
			row-gap: 0.25rem;
		}

		.time {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
			font-size: 1rem;
			display: flex;
			align-items: center;
		}

		.content {
			grid-column: 2;
			grid-row: 2;
		}

		.dot {
			grid-row: 1 / -1;
			grid-column: 1;
			align-self: center;
		}
	}
</style>
