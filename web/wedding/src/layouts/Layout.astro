---
import '@fontsource-variable/lora';
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/poppy.png" />
		<link rel="preload" href="/fonts/BrittanySignature.ttf" as="font" type="font/ttf" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>Ragnhild og Henriks bryllup</title>
	</head>
	<body>
		<Navbar />
		<main id="content">
			<slot />
		</main>
	</body>
</html>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(section[id]) {
		scroll-margin-top: 70px;
	}

	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #faf8be;
		font-family:
			'Lora Variable', Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial,
			sans-serif;
	}
	:global(@font-face) {
		font-family: 'Brittany';
		src: url('/fonts/BrittanySignature.ttf') format('truetype');
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	#content {
		position: relative;
		min-height: 100vh;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		padding: 3rem 1.5rem;
		padding-top: calc(3rem + 60px);
		box-sizing: border-box;
	}
</style>
